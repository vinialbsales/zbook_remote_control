# Opcoes proprias do app. O resto do Kconfig vem do Zephyr.

mainmenu "zbook remote control"

config APP_IR_DEBUG
	bool "Imprimir toda captura IR no console"
	help
	  Imprime cada captura do receptor, dentro ou fora do modo gravar:
	  instante da primeira borda, intervalo desde a captura anterior,
	  duracoes brutas e o resultado de cada quadro decodificado
	  separadamente, com o tempo de decodificacao na placa.
	  Serve para diagnosticar controles que mandam varios quadros por
	  toque. A 115200 baud, a impressao trava o main por ~25 ms numa
	  captura tipica e ate ~130 ms numa de 200 bordas. Desligada, o
	  codigo nao vai para o binario.

config APP_IR_ROBUST_FALLBACK
	bool "Decodificador IR robusto como reserva do convencional"
	default y
	help
	  O decodificador tenta primeiro o caminho convencional (tempos
	  conferidos um a um, para o sinal limpo do receptor sem o
	  capacitor de 100 nF). Com esta opcao, um quadro que ele nao le
	  vai para o caminho robusto (blocos, esticamento e busca), feito
	  para o sinal distorcido. Desligada, so o convencional roda; serve
	  para comparar os dois sem mexer no codigo. A busca do robusto
	  precisa de CONFIG_MAIN_STACK_SIZE=8192.

source "Kconfig.zephyr"
